{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/aui/tap": ["./aui/tap/src/index.ts"],
      "@/aui/store": ["./aui/store/src/index.ts"],
      "@/aui/core": ["./aui/core/src/index.ts"],
      "@/aui/assistant-stream": ["./aui/assistant-stream/src/index.ts"],
      "@/aui/react": ["./aui/react/src/index.ts"],
      "@/aui/ai-sdk": ["./aui/ai-sdk/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "aui/cli",
    "aui/metro",
    "aui/vite",
    "aui/create-assistant-ui",
    "aui/agent-launcher",
    "aui/setup-agent",
    "aui/x-buildutils",
    "aui/x-generative-compiler",
    "aui/mcp-docs-server",
    "aui/vscode",
    "aui/react-native",
    "aui/react-ink",
    "aui/react-ink-markdown",
    "aui/vue",
    "aui/svelte"
  ]
}
