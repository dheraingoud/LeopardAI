{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/leopard-ui/tap": ["./leopard-ui/tap/src/index.ts"],
      "@/leopard-ui/store": ["./leopard-ui/store/src/index.ts"],
      "@/leopard-ui/store/internal": ["./leopard-ui/store/src/internal.ts"],
      "@/leopard-ui/store/client": ["./leopard-ui/store/src/client.ts"],
      "@/leopard-ui/core/internal": ["./leopard-ui/core/src/internal.ts"],
      "@/leopard-ui/core/react": ["./leopard-ui/core/src/react/index.ts"],
      "@/leopard-ui/core/store": ["./leopard-ui/core/src/store/index.ts"],
      "@/leopard-ui/core/store/internal": ["./leopard-ui/core/src/store/internal.ts"],
      "@/leopard-ui/react-markdown": ["./leopard-ui/react-markdown/src/index.ts"],
      "@/leopard-ui/react-markdown/code-fence": ["./leopard-ui/react-markdown/src/code-fence.ts"],
      "@/leopard-ui/react-markdown/preprocess": ["./leopard-ui/react-markdown/src/preprocess.ts"],
      "@/leopard-ui/react-streamdown": ["./leopard-ui/react-streamdown/src/index.ts"],
      "@/leopard-ui/react-lexical": ["./leopard-ui/react-lexical/src/index.ts"],
      "@/leopard-ui/core": ["./leopard-ui/core/src/index.ts"],
      "@/leopard-ui/assistant-stream": ["./leopard-ui/assistant-stream/src/index.ts"],
      "@/leopard-ui/assistant-stream/internal": ["./leopard-ui/assistant-stream/src/internal.ts"],
      "@/leopard-ui/assistant-stream/resumable": ["./leopard-ui/assistant-stream/src/resumable/index.ts"],
      "@/leopard-ui/assistant-stream/utils": ["./leopard-ui/assistant-stream/src/utils.ts"],
      "@/leopard-ui/assistant-stream/utils/*": ["./leopard-ui/assistant-stream/src/utils/*"],
      "@/leopard-ui/assistant-stream/ai-sdk": ["./leopard-ui/assistant-stream/src/ai-sdk/index.ts"],
      "@/leopard-ui/cloud": ["./leopard-ui/cloud/src/index.ts"],
      "@/leopard-ui/cloud/ai-sdk": ["./leopard-ui/cloud/src/ai-sdk/index.ts"],
      "leopard-cloud": ["./leopard-ui/cloud/src/index.ts"],
      "leopard-cloud/ai-sdk": ["./leopard-ui/cloud/src/ai-sdk/index.ts"],
      "leopard-content-frame": ["./leopard-ui/safe-content-frame/src/index.ts"],
      "@/leopard-ui/generative-frame": ["./leopard-ui/generative-frame/src/index.ts"],
      "@/leopard-ui/generative-frame/spec": ["./leopard-ui/generative-frame/src/spec.ts"],
      "leopard-frame": ["./leopard-ui/generative-frame/src/index.ts"],
      "leopard-frame/spec": ["./leopard-ui/generative-frame/src/spec.ts"],
      "leopard-frame/spec/*": ["./leopard-ui/generative-frame/src/spec/*"],
      "@/leopard-ui/generative-frame/spec/*": ["./leopard-ui/generative-frame/src/spec/*"],
      "@/leopard-ui/diagrammatic": ["./leopard-ui/diagrammatic/src/index.ts"],
      "@/leopard-ui/diagrammatic/*": ["./leopard-ui/diagrammatic/src/*"],
      "@/leopard-ui/diagrammatic/spec": ["./leopard-ui/diagrammatic/src/spec/index.ts"],
      "@/leopard-ui/diagrammatic/interactive": [
        "./leopard-ui/diagrammatic/src/interactive/index.ts"
      ],
      "@/leopard-ui/diagrammatic/world": ["./leopard-ui/diagrammatic/src/world/index.ts"],
      "@/leopard-ui/heat-graph": ["./leopard-ui/heat-graph/src/index.ts"],
      "@/leopard-ui/heat-graph/*": ["./leopard-ui/heat-graph/src/*"],
      "@/leopard-ui/react-mcp": ["./leopard-ui/react-mcp/src/index.ts"],
      "@/leopard-ui/react-devtools": ["./leopard-ui/react-devtools/src/index.ts"],
      "@/leopard-ui/generative-ui": ["./leopard-ui/generative-ui/src/index.ts"],
      "@/leopard-ui/generative-ui/*": ["./leopard-ui/generative-ui/src/*"],
      "@/leopard-ui/react": ["./leopard-ui/react/src/index.ts"],
      "@/leopard-ui/ai-sdk": ["./leopard-ui/ai-sdk/src/index.ts"],
      "leopard-stream": ["./leopard-ui/assistant-stream/src/index.ts"],
      "leopard-stream/*": ["./leopard-ui/assistant-stream/src/*"],
      "leopard-stream/utils": ["./leopard-ui/assistant-stream/src/utils.ts"],
      "leopard-stream/utils/*": ["./leopard-ui/assistant-stream/src/utils/*"],
      "leopard-stream/cloud": ["./leopard-ui/assistant-stream/src/cloud.ts"],
      "leopard-stream/ai-sdk": ["./leopard-ui/assistant-stream/src/ai-sdk/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev3001/types/**/*.ts",
    ".next-dev3001/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/*.bench.ts",
    "leopard-ui/*/src/tests/**",
    "leopard-ui/cli",
    "leopard-ui/metro",
    "leopard-ui/vite",
    "leopard-ui/create-leopard",
    "leopard-ui/agent-launcher",
    "leopard-ui/setup-agent",
    "leopard-ui/x-buildutils",
    "leopard-ui/x-generative-compiler",
    "leopard-ui/mcp-docs-server",
    "leopard-ui/vscode",
    "leopard-ui/react-native",
    "leopard-ui/react-ink",
    "leopard-ui/react-ink-markdown",
    "leopard-ui/vue",
    "leopard-ui/svelte",
    "leopard-ui/react-native",
    "leopard-ui/generative-frame/src/spec/vue/**",
    "leopard-ui/generative-frame/src/spec/vue.ts",
    "leopard-ui/generative-frame/src/spec/react/native.tsx",
    "leopard-ui/generative-frame/src/spec/react.native.ts",
    "leopard-ui/generative-frame/src/spec/leopard-ui/vue.ts",
    "leopard-ui/generative-frame/src/spec/leopard-ui/native.tsx",
    "leopard-ui/generative-frame/src/spec/leopard-ui.native.ts",
    "leopard-ui/generative-frame/src/spec/leopard-ui.vue.ts",
    "leopard-ui/generative-ui/src/vue/**",
    "leopard-ui/generative-ui/src/native/**",
    "leopard-ui/generative-ui/src/vue.ts",
    "leopard-ui/generative-ui/src/spec.vue.ts",
    "leopard-ui/generative-ui/src/native.ts",
    "leopard-ui/generative-ui/src/spec.native.ts",
    "leopard-ui/generative-ui/src/spec/**"
  ]
}
