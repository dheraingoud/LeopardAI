{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/aui/tap": ["./aui/tap/src/index.ts"],
      "@/aui/store": ["./aui/store/src/index.ts"],
      "@/aui/store/internal": ["./aui/store/src/internal.ts"],
      "@/aui/store/client": ["./aui/store/src/client.ts"],
      "@/aui/core/internal": ["./aui/core/src/internal.ts"],
      "@/aui/core/react": ["./aui/core/src/react/index.ts"],
      "@/aui/core/store": ["./aui/core/src/store/index.ts"],
      "@/aui/core/store/internal": ["./aui/core/src/store/internal.ts"],
      "@/aui/react-markdown": ["./aui/react-markdown/src/index.ts"],
      "@/aui/react-markdown/code-fence": ["./aui/react-markdown/src/code-fence.ts"],
      "@/aui/react-markdown/preprocess": ["./aui/react-markdown/src/preprocess.ts"],
      "@/aui/react-streamdown": ["./aui/react-streamdown/src/index.ts"],
      "@/aui/react-lexical": ["./aui/react-lexical/src/index.ts"],
      "@/aui/core": ["./aui/core/src/index.ts"],
      "@/aui/assistant-stream": ["./aui/assistant-stream/src/index.ts"],
      "@/aui/assistant-stream/internal": ["./aui/assistant-stream/src/internal.ts"],
      "@/aui/assistant-stream/resumable": ["./aui/assistant-stream/src/resumable/index.ts"],
      "@/aui/assistant-stream/utils": ["./aui/assistant-stream/src/utils.ts"],
      "@/aui/assistant-stream/utils/*": ["./aui/assistant-stream/src/utils/*"],
      "@/aui/assistant-stream/ai-sdk": ["./aui/assistant-stream/src/ai-sdk/index.ts"],
      "@/aui/cloud": ["./aui/cloud/src/index.ts"],
      "@/aui/cloud/ai-sdk": ["./aui/cloud/src/ai-sdk/index.ts"],
      "assistant-cloud": ["./aui/cloud/src/index.ts"],
      "assistant-cloud/ai-sdk": ["./aui/cloud/src/ai-sdk/index.ts"],
      "safe-content-frame": ["./aui/safe-content-frame/src/index.ts"],
      "@/aui/generative-frame": ["./aui/generative-frame/src/index.ts"],
      "@/aui/generative-frame/spec": ["./aui/generative-frame/src/spec.ts"],
      "generative-frame": ["./aui/generative-frame/src/index.ts"],
      "generative-frame/spec": ["./aui/generative-frame/src/spec.ts"],
      "generative-frame/spec/*": ["./aui/generative-frame/src/spec/*"],
      "@/aui/generative-frame/spec/*": ["./aui/generative-frame/src/spec/*"],
      "@/aui/diagrammatic": ["./aui/diagrammatic/src/index.ts"],
      "@/aui/diagrammatic/*": ["./aui/diagrammatic/src/*"],
      "@/aui/react-mcp": ["./aui/react-mcp/src/index.ts"],
      "@/aui/react-devtools": ["./aui/react-devtools/src/index.ts"],
      "@/aui/generative-ui": ["./aui/generative-ui/src/index.ts"],
      "@/aui/react": ["./aui/react/src/index.ts"],
      "@/aui/ai-sdk": ["./aui/ai-sdk/src/index.ts"],
      "assistant-stream": ["./aui/assistant-stream/src/index.ts"],
      "assistant-stream/*": ["./aui/assistant-stream/src/*"],
      "assistant-stream/utils": ["./aui/assistant-stream/src/utils.ts"],
      "assistant-stream/utils/*": ["./aui/assistant-stream/src/utils/*"],
      "assistant-stream/cloud": ["./aui/assistant-stream/src/cloud.ts"],
      "assistant-stream/ai-sdk": ["./aui/assistant-stream/src/ai-sdk/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/*.bench.ts",
    "aui/*/src/tests/**",
    "aui/cli",
    "aui/metro",
    "aui/vite",
    "aui/create-assistant-ui",
    "aui/agent-launcher",
    "aui/setup-agent",
    "aui/x-buildutils",
    "aui/x-generative-compiler",
    "aui/mcp-docs-server",
    "aui/vscode",
    "aui/react-native",
    "aui/react-ink",
    "aui/react-ink-markdown",
    "aui/vue",
    "aui/svelte",
    "aui/react-native",
    "aui/generative-frame/src/spec/vue/**",
    "aui/generative-frame/src/spec/vue.ts",
    "aui/generative-frame/src/spec/react/native.tsx",
    "aui/generative-frame/src/spec/react.native.ts",
    "aui/generative-frame/src/spec/assistant-ui/vue.ts",
    "aui/generative-frame/src/spec/assistant-ui/native.tsx",
    "aui/generative-frame/src/spec/assistant-ui.native.ts",
    "aui/generative-frame/src/spec/assistant-ui.vue.ts",
    "aui/generative-ui/src/vue/**",
    "aui/generative-ui/src/native/**",
    "aui/generative-ui/src/vue.ts",
    "aui/generative-ui/src/spec.vue.ts",
    "aui/generative-ui/src/native.ts",
    "aui/generative-ui/src/spec.native.ts",
    "aui/generative-ui/src/spec/**"
  ]
}
