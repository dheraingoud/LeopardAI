# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Convex Database
NEXT_PUBLIC_CONVEX_URL=

# NVIDIA NIM API
NVIDIA_API_KEY=

# Web tools (semi-agentic surfaces).
# Set ENABLE_WEB_FETCH=1 to expose the webFetch tool (fetch a URL → readable text).
# Set ENABLE_WEB_SEARCH=1 to expose the webSearch tool — keyless DuckDuckGo
# backend, no API key required (query → titles+URLs only; content retrieval
# stays on webFetch).
ENABLE_WEB_FETCH=1
ENABLE_WEB_SEARCH=1
