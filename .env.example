# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat

# Convex Database
NEXT_PUBLIC_CONVEX_URL=

# NVIDIA NIM API
NVIDIA_API_KEY=

# Web tools (semi-agentic surfaces).
# webFetch is CORE — always on, no env var (user toggle lives in the composer
# + menu). ENABLE_WEB_SEARCH=1 additionally exposes webSearch — keyless
# DuckDuckGo backend, no API key required (query → titles+URLs only; content
# retrieval stays on webFetch).
ENABLE_WEB_SEARCH=1
